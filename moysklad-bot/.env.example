# Токен бота, выданный @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# API-токен МойСклад: Настройки аккаунта -> Обмен данными -> API -> Токены доступа
MOYSKLAD_TOKEN=your_moysklad_api_token

# Telegram ID владельца(ев) через запятую.
# Узнать свой ID можно у бота @userinfobot
OWNER_IDS=111111111

# Telegram ID директора(ов) через запятую (не обязательно).
# Владелец и директор видят полный отчёт — доход, расход и остаток кассы.
DIRECTOR_IDS=

# Telegram ID сотрудников через запятую.
# Сотрудники видят ТОЛЬКО остаток кассы (без цифр по доходу/расходу).
EMPLOYEE_IDS=222222222,333333333,444444444,555555555,666666666

# Во сколько (по времени сервера) каждый день присылать владельцу и
# директору полный отчёт (доход/расход/остаток). Формат ЧЧ:ММ. По
# умолчанию 20:00. Сотрудникам этот отчёт не отправляется — они могут
# только сами запросить остаток кассы командой /balance.
DAILY_REPORT_TIME=20:00
