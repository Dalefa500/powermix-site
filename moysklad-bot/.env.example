# Токен бота, выданный @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# API-токен МойСклад: Настройки аккаунта -> Обмен данными -> API -> Токены доступа
MOYSKLAD_TOKEN=your_moysklad_api_token

# Telegram ID владельца(ев) через запятую.
# Узнать свой ID можно у бота @userinfobot
OWNER_IDS=111111111

# Telegram ID директора(ов) через запятую.
# Владелец и директор видят полный отчёт — доход, расход, остаток кассы,
# остатки на складе и задолженность контрагентов.
DIRECTOR_IDS=222222222

# Telegram ID сотрудников через запятую (не обязательно, можно оставить пустым).
# Сотрудники (если есть) видят ТОЛЬКО остаток кассы (без цифр по доходу/расходу).
EMPLOYEE_IDS=

# Во сколько (по времени сервера) каждый день присылать владельцу и
# директору полный отчёт (доход/расход/остаток). Формат ЧЧ:ММ. По
# умолчанию 20:00.
DAILY_REPORT_TIME=20:00
